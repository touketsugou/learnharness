# Never send data or secrets into the build context.
data/
.fresh-data/
real-data-extraction/
auth.json
*credentials.json*
.env*
.memory/
SCOPE.md

# Rebuilt inside the image / not needed by the server.
.git/
node_modules/
.next/
dist/
# Plugin builds (npm run plugins:setup / build): an image builds them from
# source, and a copied core-plugins/ cannot be renamed on overlayfs (EXDEV).
core-plugins/
.core-plugins-*/
public/plugin-authoring/
plugins/*/node_modules/
plugins/*/dist/
plugins/*/.sdk/
ios/
.claude/
*.log
.DS_Store
*.tsbuildinfo
